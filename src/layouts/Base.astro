---
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Independent investigative journalism. Watch and read our latest investigations.',
} = Astro.props;

const favicon =
  'data:image/svg+xml,' +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" fill="#1a2906"/><text x="32" y="44" font-family="Inter,-apple-system,sans-serif" font-size="36" font-weight="600" fill="#f2f1e8" text-anchor="middle">V</text></svg>`
  );
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a2906" />
    <link rel="icon" href={favicon} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
