---
import type { Story } from '../data/stories';

interface Props {
  story: Story;
  variant?: 'hero' | 'card' | 'thumb';
  priority?: boolean;
}

const { story, variant = 'card', priority = false } = Astro.props;
---

<figure class:list={['media', `media--${variant}`]}>
  {
    story.image && (
      <img
        src={story.image}
        alt={story.alt}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        data-emerge
      />
    )
  }
  <div class="media-actions">
    {
      story.video && (
        <button class="act act--watch" data-story={story.slug} data-mode="watch">
          Watch
          <svg viewBox="0 0 10 12" aria-hidden="true">
            <path d="M0 0l10 6-10 6z" fill="currentColor" />
          </svg>
        </button>
      )
    }
    {story.duration && <span class="act-time">{story.duration}</span>}
    <button class="act" data-story={story.slug} data-mode="read">Read</button>
  </div>
</figure>

<style>
  .media {
    position: relative;
    overflow: hidden;
    background: var(--green-deep);
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Once the WebGL reveal owns this image, the DOM img only keeps layout */
  .media img.is-emerged {
    opacity: 0;
  }

  .media--hero {
    aspect-ratio: 8 / 3;
    min-height: 320px;
    max-height: 78vh;
  }

  .media--card {
    aspect-ratio: 15 / 8;
  }

  .media--thumb {
    aspect-ratio: 2 / 1;
  }

  .media-actions {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 3; /* above the fixed .emerge-canvas overlay */
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    color: #fff;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.38), rgba(0, 0, 0, 0));
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .media--hero .media-actions {
    padding: 22px var(--pad);
  }

  .act {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .act:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .act--watch {
    font-weight: 700;
  }

  .act--watch svg {
    width: 8px;
    height: 10px;
  }

  .act-time {
    opacity: 0.75;
    margin-left: -6px;
  }
</style>
