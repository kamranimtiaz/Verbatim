---
import type { Story } from '../data/stories';

interface Props {
  stories: Story[];
}

const { stories } = Astro.props;

const playerData = Object.fromEntries(
  stories.map((s) => [s.slug, { title: s.title, video: s.video, poster: s.image }])
);
---

<dialog class="story-modal" id="story-modal" aria-labelledby="modal-title">
  <div class="stage" data-view="watch">
    <button class="close" data-close aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M2 2l20 20M22 2L2 22" stroke="currentColor" stroke-width="1.6" />
      </svg>
    </button>

    <!-- WATCH -->
    <div class="watch" data-panel="watch">
      <video id="modal-video" playsinline preload="metadata"></video>

      <div class="hud">
        <div class="hud-title-row">
          <h2 class="hud-title" id="modal-title">Title</h2>
          <button class="hud-read label" data-switch="read">Read</button>
        </div>

        <div
          class="progress"
          id="progress"
          role="slider"
          aria-label="Seek"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          tabindex="0"
        >
          <div class="progress-track">
            <div class="progress-played" id="progress-played"></div>
          </div>
        </div>

        <div class="hud-controls">
          <div class="hud-left">
            <button class="play label" id="play-btn" aria-label="Play">
              <span class="play-label" id="play-label">Play</span>
              <svg class="ic-play" viewBox="0 0 10 12" aria-hidden="true">
                <path d="M0 0l10 6-10 6z" fill="currentColor"></path>
              </svg>
              <svg class="ic-pause" viewBox="0 0 10 12" aria-hidden="true">
                <path d="M1 0h2.6v12H1zM6.4 0H9v12H6.4z" fill="currentColor"></path>
              </svg>
            </button>
            <span class="time label" id="time-label">0:00 / 0:00</span>
          </div>

          <div class="hud-right">
            <div class="speed-wrap">
              <button class="icon-btn" id="speed-btn" aria-label="Playback speed" aria-expanded="false">
                <svg viewBox="0 0 22 18" aria-hidden="true">
                  <g stroke="currentColor" stroke-width="1.6" fill="none">
                    <path d="M0 4h22M0 14h22"></path>
                  </g>
                  <circle cx="7" cy="4" r="2.8" fill="var(--green, #1a2906)" stroke="currentColor" stroke-width="1.6"></circle>
                  <circle cx="15" cy="14" r="2.8" fill="var(--green, #1a2906)" stroke="currentColor" stroke-width="1.6"></circle>
                </svg>
              </button>
              <ul class="speed-menu label" id="speed-menu" hidden>
                {
                  [0.5, 0.75, 1, 1.25, 1.5, 2].map((rate) => (
                    <li>
                      <button data-rate={rate} aria-pressed={rate === 1 ? 'true' : 'false'}>
                        {rate}&times;
                      </button>
                    </li>
                  ))
                }
              </ul>
            </div>

            <button class="icon-btn" id="mute-btn" aria-label="Mute">
              <svg class="ic-vol" viewBox="0 0 22 18" aria-hidden="true">
                <path d="M2 6v6h4l5 4V2L6 6H2z" fill="currentColor"></path>
                <path d="M14 5.5a5 5 0 010 7M16.5 3a8.5 8.5 0 010 12" stroke="currentColor" stroke-width="1.6" fill="none"></path>
              </svg>
              <svg class="ic-muted" viewBox="0 0 22 18" aria-hidden="true">
                <path d="M2 6v6h4l5 4V2L6 6H2z" fill="currentColor"></path>
                <path d="M14 6l6 6M20 6l-6 6" stroke="currentColor" stroke-width="1.6"></path>
              </svg>
            </button>

            <button class="icon-btn" id="fs-btn" aria-label="Fullscreen">
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path
                  d="M1 7V1h6M13 1h6v6M19 13v6h-6M7 19H1v-6"
                  stroke="currentColor"
                  stroke-width="1.6"
                  fill="none"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- READ -->
    <div class="read" data-panel="read">
      {
        stories.map((s) => (
          <article class="read-article" data-article={s.slug} hidden>
            <header class="read-header">
              <p class="read-meta label">
                {s.date}
                {s.duration && <span class="read-dot" aria-hidden="true" />}
                {s.video && (
                  <button class="read-watch" data-story={s.slug} data-mode="watch">
                    Watch
                    <svg viewBox="0 0 10 12" aria-hidden="true">
                      <path d="M0 0l10 6-10 6z" fill="currentColor" />
                    </svg>
                    {s.duration}
                  </button>
                )}
              </p>
              <h2 class="read-title">{s.title}</h2>
            </header>
            <div class="read-body">
              {s.body.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</dialog>

<script is:inline type="application/json" id="player-data" set:html={JSON.stringify(playerData)} />

<script>
  const dialog = document.getElementById('story-modal') as HTMLDialogElement;
  const stage = dialog.querySelector('.stage') as HTMLElement;
  const video = document.getElementById('modal-video') as HTMLVideoElement;
  const hudTitle = document.getElementById('modal-title') as HTMLElement;
  const playBtn = document.getElementById('play-btn') as HTMLButtonElement;
  const playLabel = document.getElementById('play-label') as HTMLElement;
  const timeLabel = document.getElementById('time-label') as HTMLElement;
  const progress = document.getElementById('progress') as HTMLElement;
  const played = document.getElementById('progress-played') as HTMLElement;
  const muteBtn = document.getElementById('mute-btn') as HTMLButtonElement;
  const fsBtn = document.getElementById('fs-btn') as HTMLButtonElement;
  const speedBtn = document.getElementById('speed-btn') as HTMLButtonElement;
  const speedMenu = document.getElementById('speed-menu') as HTMLElement;

  const data = JSON.parse(
    (document.getElementById('player-data') as HTMLScriptElement).textContent || '{}'
  ) as Record<string, { title: string; video: string | null; poster: string | null }>;

  let currentSlug: string | null = null;

  function fmt(sec: number): string {
    if (!Number.isFinite(sec) || sec < 0) sec = 0;
    const s = Math.floor(sec % 60);
    const m = Math.floor((sec / 60) % 60);
    const h = Math.floor(sec / 3600);
    const mm = h ? String(m).padStart(2, '0') : String(m);
    const ss = String(s).padStart(2, '0');
    return h ? `${h}:${mm}:${ss}` : `${mm}:${ss}`;
  }

  function updateTime() {
    timeLabel.textContent = `${fmt(video.currentTime)} / ${fmt(video.duration)}`;
    const ratio = video.duration ? video.currentTime / video.duration : 0;
    played.style.width = `${ratio * 100}%`;
    progress.setAttribute('aria-valuenow', String(Math.round(ratio * 100)));
  }

  function setView(view: 'watch' | 'read') {
    stage.dataset.view = view;
    if (view === 'read') video.pause();
  }

  function showArticle(slug: string) {
    dialog.querySelectorAll<HTMLElement>('[data-article]').forEach((el) => {
      el.hidden = el.dataset.article !== slug;
    });
  }

  function open(slug: string, mode: 'watch' | 'read') {
    const story = data[slug];
    if (!story) return;

    hudTitle.textContent = story.title;
    showArticle(slug);

    if (story.video && slug !== currentSlug) {
      video.src = story.video;
      if (story.poster) video.poster = story.poster;
      played.style.width = '0%';
      timeLabel.textContent = '0:00 / 0:00';
    }
    currentSlug = slug;

    const view = mode === 'watch' && story.video ? 'watch' : 'read';
    setView(view);

    if (!dialog.open) {
      dialog.showModal();
      document.body.classList.add('modal-open');
    }

    if (view === 'watch') {
      video.play().catch(() => {});
    } else {
      (dialog.querySelector('.read') as HTMLElement).scrollTop = 0;
    }
  }

  function close() {
    dialog.close();
  }

  dialog.addEventListener('close', () => {
    video.pause();
    document.body.classList.remove('modal-open');
    speedMenu.hidden = true;
    speedBtn.setAttribute('aria-expanded', 'false');
  });

  // Delegated triggers: WATCH / READ buttons anywhere on the page or inside the modal
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-story][data-mode]');
    if (trigger) {
      open(trigger.dataset.story!, trigger.dataset.mode as 'watch' | 'read');
      return;
    }
    const switcher = (e.target as HTMLElement).closest<HTMLElement>('[data-switch]');
    if (switcher && currentSlug) {
      setView(switcher.dataset.switch as 'watch' | 'read');
      if (switcher.dataset.switch === 'watch') video.play().catch(() => {});
      return;
    }
    if ((e.target as HTMLElement).closest('[data-close]')) close();
  });

  // Click on backdrop closes
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) close();
  });

  // --- Player controls ---

  function togglePlay() {
    if (video.paused || video.ended) video.play().catch(() => {});
    else video.pause();
  }

  playBtn.addEventListener('click', togglePlay);
  video.addEventListener('click', togglePlay);

  video.addEventListener('play', () => {
    stage.dataset.playing = 'true';
    playLabel.textContent = 'Pause';
    playBtn.setAttribute('aria-label', 'Pause');
  });
  video.addEventListener('pause', () => {
    stage.dataset.playing = 'false';
    playLabel.textContent = 'Play';
    playBtn.setAttribute('aria-label', 'Play');
  });

  video.addEventListener('timeupdate', updateTime);
  video.addEventListener('loadedmetadata', updateTime);

  // Seek by pointer (click + drag)
  let seeking = false;

  function seekFromEvent(e: PointerEvent) {
    const rect = progress.getBoundingClientRect();
    const ratio = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
    if (video.duration) {
      video.currentTime = ratio * video.duration;
      updateTime();
    }
  }

  progress.addEventListener('pointerdown', (e) => {
    seeking = true;
    progress.setPointerCapture(e.pointerId);
    seekFromEvent(e);
  });
  progress.addEventListener('pointermove', (e) => {
    if (seeking) seekFromEvent(e);
  });
  progress.addEventListener('pointerup', (e) => {
    seeking = false;
    progress.releasePointerCapture(e.pointerId);
  });
  progress.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
      e.preventDefault();
      video.currentTime += e.key === 'ArrowRight' ? 5 : -5;
    }
  });

  // Mute
  muteBtn.addEventListener('click', () => {
    video.muted = !video.muted;
  });
  video.addEventListener('volumechange', () => {
    stage.dataset.muted = String(video.muted);
    muteBtn.setAttribute('aria-label', video.muted ? 'Unmute' : 'Mute');
  });

  // Fullscreen on the watch panel so the HUD stays visible
  const watchPanel = dialog.querySelector('[data-panel="watch"]') as HTMLElement;
  fsBtn.addEventListener('click', () => {
    if (document.fullscreenElement) {
      document.exitFullscreen();
    } else {
      watchPanel.requestFullscreen?.().catch(() => {});
    }
  });

  // Playback speed menu
  speedBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    speedMenu.hidden = !speedMenu.hidden;
    speedBtn.setAttribute('aria-expanded', String(!speedMenu.hidden));
  });
  speedMenu.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-rate]');
    if (!btn) return;
    video.playbackRate = Number(btn.dataset.rate);
    speedMenu.querySelectorAll('[data-rate]').forEach((b) => {
      b.setAttribute('aria-pressed', String(b === btn));
    });
    speedMenu.hidden = true;
    speedBtn.setAttribute('aria-expanded', 'false');
  });
  document.addEventListener('click', (e) => {
    if (!speedMenu.hidden && !(e.target as HTMLElement).closest('.speed-wrap')) {
      speedMenu.hidden = true;
      speedBtn.setAttribute('aria-expanded', 'false');
    }
  });

  // Deep link: /?story=<slug>&mode=<watch|read> opens the popup on load
  const params = new URLSearchParams(location.search);
  const linked = params.get('story');
  if (linked && data[linked]) {
    open(linked, params.get('mode') === 'read' ? 'read' : 'watch');
  }

  // Space toggles playback while the watch view is open
  dialog.addEventListener('keydown', (e) => {
    if (e.key === ' ' && stage.dataset.view === 'watch' && !(e.target as HTMLElement).closest('button')) {
      e.preventDefault();
      togglePlay();
    }
  });
</script>

<style>
  .story-modal {
    display: none;
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    padding: var(--pad);
    border: 0;
    background: transparent;
    color: var(--cream);
  }

  .story-modal[open] {
    display: grid;
    place-items: center;
  }

  .story-modal::backdrop {
    background: rgba(14, 18, 6, 0.95);
  }

  .stage {
    position: relative;
    width: min(1240px, 100%);
    animation: stage-in 0.28s ease both;
  }

  @keyframes stage-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .close {
    position: absolute;
    top: 18px;
    right: 20px;
    z-index: 4;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    color: #fff;
  }

  .close svg {
    width: 20px;
    height: 20px;
  }

  .close:hover {
    opacity: 0.7;
  }

  .close:focus-visible,
  .icon-btn:focus-visible,
  .progress:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 3px;
  }

  .stage[data-view='read'] .close {
    color: var(--green);
  }

  /* Panels */
  .stage[data-view='watch'] [data-panel='read'] {
    display: none;
  }

  .stage[data-view='read'] [data-panel='watch'] {
    display: none;
  }

  /* --- Watch view --- */
  .watch {
    position: relative;
    background: #000;
  }

  .watch video {
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 84vh;
    object-fit: cover;
    background: #000;
    filter: grayscale(1);
    cursor: pointer;
  }

  .watch:fullscreen video {
    max-height: none;
    height: 100%;
    aspect-ratio: auto;
  }

  .hud {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 2;
    padding: clamp(18px, 3vw, 34px);
    color: #fff;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0));
  }

  .hud-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 16px;
  }

  .hud-title {
    font-size: clamp(16px, 2.2vw, 24px);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.25;
  }

  .hud-read:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .progress {
    padding-block: 6px;
    cursor: pointer;
    touch-action: none;
  }

  .progress-track {
    height: 2px;
    background: rgba(255, 255, 255, 0.35);
  }

  .progress-played {
    width: 0%;
    height: 100%;
    background: #fff;
  }

  .hud-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 12px;
  }

  .hud-left {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .play {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 700;
  }

  .play svg {
    width: 9px;
    height: 11px;
  }

  .stage[data-playing='true'] .ic-play,
  .stage:not([data-playing='true']) .ic-pause {
    display: none;
  }

  .time {
    opacity: 0.85;
    font-variant-numeric: tabular-nums;
  }

  .hud-right {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .icon-btn {
    width: 38px;
    height: 34px;
    display: grid;
    place-items: center;
  }

  .icon-btn:hover {
    opacity: 0.7;
  }

  .icon-btn svg {
    width: 20px;
    height: 17px;
  }

  #fs-btn svg {
    width: 17px;
    height: 17px;
  }

  .stage[data-muted='true'] .ic-vol,
  .stage:not([data-muted='true']) .ic-muted {
    display: none;
  }

  .speed-wrap {
    position: relative;
  }

  .speed-menu {
    position: absolute;
    bottom: calc(100% + 10px);
    right: 0;
    min-width: 90px;
    padding: 6px;
    background: rgba(10, 13, 4, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .speed-menu button {
    display: block;
    width: 100%;
    padding: 7px 12px;
    text-align: left;
  }

  .speed-menu button:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .speed-menu button[aria-pressed='true'] {
    background: var(--cream);
    color: var(--green);
  }

  /* --- Read view --- */
  .read {
    max-height: min(860px, 88vh);
    overflow-y: auto;
    background: var(--cream);
    color: var(--green);
  }

  .read-article {
    padding: clamp(28px, 5vw, 64px);
    padding-top: clamp(48px, 6vw, 72px);
  }

  .read-header {
    max-width: 720px;
    margin-inline: auto;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(26, 41, 6, 0.25);
    margin-bottom: 32px;
  }

  .read-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    opacity: 0.85;
    margin-bottom: 18px;
  }

  .read-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
  }

  .read-watch {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-weight: 700;
  }

  .read-watch svg {
    width: 8px;
    height: 10px;
  }

  .read-watch:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .read-title {
    font-size: clamp(22px, 3.4vw, 34px);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.2;
  }

  .read-body {
    max-width: 720px;
    margin-inline: auto;
  }

  .read-body p {
    font-size: 16px;
    line-height: 1.75;
    margin-bottom: 1.4em;
  }

  .read-body p:first-of-type {
    font-weight: 500;
  }
</style>
